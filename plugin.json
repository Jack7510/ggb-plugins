{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ggb-plugins",
  "version": "0.8.3",
  "description": "分析中英文二维数学题、作图并核验交付 GeoGebra 文件，不提供题目答案；Agent 自选中文或英文工作语言。",
  "author": {
    "name": "Jack7510"
  },
  "repository": "https://github.com/Jack7510/ggb-plugins",
  "license": "MIT",
  "keywords": [
    "geogebra",
    "geometry",
    "mathematics"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "GeoGebra Construction",
        "shortDescription": "二维数学与代数题到经核验、可交互的 GGB 文件"
      }
    }
  }
}
