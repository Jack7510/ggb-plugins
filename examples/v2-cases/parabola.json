            "expression": "AreEqual(Tangent(T,p),b)",
            "expected": true,
            "mode": "algebra",
            "scope": "sampled"
          },
          {
            "kind": "dependsOn",
            "subjects": [
              "T",
              "A"
            ],
            "scope": "sampled"
          }
        ]
      },
      {
        "id": "style",
        "source": "中垂线标红",
        "checks": [
          {
            "kind": "style",
            "subjects": [
              "b"
            ],
            "scope": "sampled",
            "properties": {
              "color": "#D74830",
              "lineThickness": 5
            }
          }
        ]
      }
    ],
    "styles": [
      {
