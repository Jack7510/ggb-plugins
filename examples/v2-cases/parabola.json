{
  "protocolVersion": 2,
  "prompt": "抛物线 y²=4x 的焦点为 F，A 为准线上一点，作 FA 的中垂线 b，标出切点 T 并核验相切关系。中垂线标红，A 可沿准线拖动。",
  "locale": "zh-CN",
  "outputDir": "output/parabola",
  "plan": {
    "program": [
      {
        "id": "F",
        "op": "native",
        "source": "F=(1,0)",
        "mode": "algebra"
      },
      {
        "id": "d",
        "op": "native",
        "source": "d: x=-1",
        "mode": "algebra"
      },
      {
        "id": "p",
        "op": "native",
        "source": "p=Parabola(F,d)",
        "mode": "algebra"
      },
      {
        "id": "A",
        "op": "native",
        "source": "A=Point(d)",
        "mode": "algebra",
        "initial": [
          -1,
          2
        ]
      },
      {
        "id": "M",
        "op": "native",
        "source": "M=Midpoint(F,A)",
        "mode": "algebra"
      },
      {
        "id": "s",
        "op": "native",
        "source": "s=Line(F,A)",
        "mode": "algebra"
      },
      {
        "id": "b",
        "op": "native",
        "source": "b=OrthogonalLine(M,s)",
        "mode": "algebra"
      },
      {
        "id": "FA",
        "op": "native",
        "source": "FA=Segment(F,A)",
        "mode": "algebra"
      },
      {
        "id": "T",
        "op": "native",
        "source": "T=((y(A))^2/4,y(A))",
        "mode": "algebra"
      },
      {
        "id": "FT",
        "op": "native",
        "source": "FT=Segment(F,T)",
        "mode": "algebra"
      },
      {
        "id": "AT",
        "op": "native",
        "source": "AT=Segment(A,T)",
        "mode": "algebra"
      }
    ],
    "requirements": [
      {
        "id": "focus",
        "source": "抛物线 y²=4x 的焦点为 F",
        "checks": [
          {
            "kind": "coordinate",
            "subjects": [
              "F"
            ],
            "scope": "initial",
            "coordinates": [
              1,
              0
            ]
          },
          {
            "kind": "type",
            "subjects": [
              "p"
            ],
            "scope": "sampled",
            "objectType": "parabola"
          },
          {
            "kind": "dependsOn",
            "subjects": [
              "p",
              "F",
              "d"
            ],
            "scope": "sampled"
          }
        ]
      },
      {
        "id": "path",
        "source": "A 为准线上一点",
