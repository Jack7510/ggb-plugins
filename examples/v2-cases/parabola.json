            "scope": "sampled"
          },
          {
            "kind": "dependsOn",
            "subjects": [
              "A",
              "d"
            ],
            "scope": "sampled"
          }
        ]
      },
      {
        "id": "bisector",
        "source": "作 FA 的中垂线 b",
        "checks": [
          {
            "kind": "midpoint",
            "subjects": [
              "M",
              "F",
              "A"
