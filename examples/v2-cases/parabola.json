            "scope": "sampled"
          },
          {
            "kind": "perpendicular",
            "subjects": [
              "b",
              "s"
            ],
            "scope": "sampled"
          },
          {
            "kind": "expression",
            "subjects": [
              "M",
              "b"
            ],
            "expression": "Distance(M,b)",
            "expected": 0,
            "mode": "algebra",
            "scope": "sampled"
          },
          {
            "kind": "dependsOn",
            "subjects": [
              "b",
              "F",
              "A"
            ],
            "scope": "sampled"
          }
        ]
      },
      {
        "id": "tangent",
        "source": "标出切点 T 并核验相切关系",
        "checks": [
          {
            "kind": "expression",
            "subjects": [
              "T",
              "p"
            ],
            "expression": "Distance(T,p)",
            "expected": 0,
            "mode": "algebra",
            "scope": "sampled"
          },
          {
            "kind": "expression",
            "subjects": [
              "T",
              "b"
            ],
            "expression": "Distance(T,b)",
            "expected": 0,
            "mode": "algebra",
            "scope": "sampled"
          },
          {
            "kind": "expression",
            "subjects": [
              "T",
              "A"
            ],
            "expression": "y(T)==y(A)",
            "expected": true,
            "mode": "algebra",
            "scope": "sampled"
          },
          {
            "kind": "expression",
            "subjects": [
              "T",
              "b"
