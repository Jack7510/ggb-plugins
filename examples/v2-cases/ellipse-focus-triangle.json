{
  "protocolVersion": 2,
  "prompt": "Draw the ellipse x²/a²+y²=1 and its two dependent foci, for 2≤a≤3. Draw a chord through its first focus and the triangle with its second focus.",
  "locale": "en",
  "title": "Ellipse focus chord and triangle",
  "outputDir": "output",
  "plan": {
    "program": [
      {
        "id": "a",
        "source": "a=Slider(2,3,1)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "ell",
        "source": "ell: x^2/a^2+y^2=1",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "L",
        "source": "L={Focus(ell)}",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "F_1",
        "source": "F_1=Element(L,1)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "F_2",
        "source": "F_2=Element({Focus(ell)},2)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "ang",
        "source": "ang=Slider(0.5,2.5,0.1)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "Q",
        "source": "Q=F_1+(cos(ang),sin(ang))",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "l",
        "source": "l=Line(F_1,Q)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "A",
        "source": "A=Intersect(ell,l,1)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "B",
        "source": "B=Intersect(ell,l,2)",
        "op": "native",
        "mode": "algebra"
      },
      {
        "id": "tri",
        "source": "tri=Polygon({A,B,F_2})",
        "op": "native",
        "mode": "algebra"
      }
    ],
