{
  "protocolVersion": 2,
  "prompt": "画一个圆和圆外一点 P，从 P 作圆的两条切线，切点为 A、B。显示 PA、PB 以及两个切点处的直角标记，允许移动 P。初始圆心为 O，半径为3；P 保持在圆外。",
  "locale": "zh-CN",
  "outputDir": "output/geometry-benchmark",
  "plan": {
    "program": [
      {
        "id": "O",
        "op": "native",
        "mode": "algebra",
        "source": "O=(0,0)"
      },
      {
        "id": "R",
        "op": "native",
        "mode": "algebra",
        "source": "R=(3,0)"
      },
      {
        "id": "circle",
        "op": "native",
        "mode": "algebra",
        "source": "circle=Circle(O,R)"
      },
      {
        "id": "P",
        "op": "native",
        "mode": "algebra",
        "source": "P=(6,1)"
      },
      {
        "id": "polar",
        "op": "native",
        "mode": "algebra",
        "source": "polar=Polar(P,circle)"
      },
      {
        "id": "A",
        "op": "native",
        "mode": "algebra",
        "source": "A=Intersect(polar,circle,1)"
      },
      {
        "id": "B",
        "op": "native",
        "mode": "algebra",
        "source": "B=Intersect(polar,circle,2)"
      },
      {
        "id": "tA",
        "op": "native",
        "mode": "algebra",
        "source": "tA=Line(P,A)"
      },
      {
        "id": "tB",
        "op": "native",
        "mode": "algebra",
        "source": "tB=Line(P,B)"
      },
      {
        "id": "rA",
        "op": "native",
        "mode": "algebra",
        "source": "rA=Segment(O,A)"
      },
      {
        "id": "rB",
        "op": "native",
        "mode": "algebra",
        "source": "rB=Segment(O,B)"
      },
      {
        "id": "lenPA",
        "op": "native",
        "mode": "algebra",
        "source": "lenPA=Distance(P,A)"
      },
      {
        "id": "lenPB",
        "op": "native",
        "mode": "algebra",
        "source": "lenPB=Distance(P,B)"
      },
      {
        "id": "rightA",
        "op": "native",
        "mode": "algebra",
        "source": "rightA=Angle(O,A,P)"
      },
      {
        "id": "rightB",
        "op": "native",
        "mode": "algebra",
        "source": "rightB=Angle(P,B,O)"
      },
      {
        "id": "message",
        "op": "native",
        "mode": "algebra",
        "source": "message=\"PA=\"+lenPA+\"  PB=\"+lenPB"
      },
      {
        "id": "NotePos",
        "op": "native",
        "mode": "algebra",
        "source": "NotePos=(-3,5)"
      },
      {
        "id": "note",
        "op": "native",
        "mode": "algebra",
        "source": "note=Text(message,NotePos)"
      }
    ],
