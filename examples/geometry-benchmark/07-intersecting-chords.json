{
  "protocolVersion": 2,
  "prompt": "在一个圆内取点 P，过 P 作两条不同直线，分别交圆于 A、B 和 C、D。显示 PA·PB 与 PC·PD，允许移动 P 和两条直线。初始圆心 O=(0,0)，半径4；P 保持在圆内，两条直线保持不同。",
  "locale": "zh-CN",
  "outputDir": "output/geometry-benchmark",
  "plan": {
    "program": [
      {
        "id": "O",
        "op": "native",
        "mode": "algebra",
        "source": "O=(0,0)"
      },
      {
        "id": "circle",
        "op": "native",
        "mode": "algebra",
        "source": "circle=Circle(O,4)"
      },
      {
        "id": "P",
        "op": "native",
        "mode": "algebra",
        "source": "P=(0.5,0.5)"
      },
      {
        "id": "U",
        "op": "native",
        "mode": "algebra",
        "source": "U=(2,1.2)"
      },
      {
        "id": "V",
        "op": "native",
        "mode": "algebra",
        "source": "V=(-1,2.5)"
      },
      {
        "id": "l",
        "op": "native",
        "mode": "algebra",
        "source": "l=Line(P,U)"
      },
      {
        "id": "m",
        "op": "native",
        "mode": "algebra",
        "source": "m=Line(P,V)"
      },
      {
        "id": "A",
        "op": "native",
        "mode": "algebra",
        "source": "A=Intersect(l,circle,1)"
      },
      {
        "id": "B",
        "op": "native",
        "mode": "algebra",
        "source": "B=Intersect(l,circle,2)"
      },
      {
        "id": "C",
        "op": "native",
        "mode": "algebra",
        "source": "C=Intersect(m,circle,1)"
      },
      {
        "id": "D",
        "op": "native",
        "mode": "algebra",
        "source": "D=Intersect(m,circle,2)"
      },
      {
        "id": "productAB",
        "op": "native",
        "mode": "algebra",
        "source": "productAB=Distance(P,A)*Distance(P,B)"
      },
      {
        "id": "productCD",
        "op": "native",
        "mode": "algebra",
        "source": "productCD=Distance(P,C)*Distance(P,D)"
      },
      {
        "id": "message",
        "op": "native",
        "mode": "algebra",
        "source": "message=\"PA×PB=\"+productAB+\"  PC×PD=\"+productCD"
      },
      {
        "id": "NotePos",
        "op": "native",
        "mode": "algebra",
        "source": "NotePos=(-4,6)"
      },
      {
        "id": "note",
        "op": "native",
        "mode": "algebra",
        "source": "note=Text(message,NotePos)"
      }
    ],
