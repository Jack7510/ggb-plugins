{
  "protocolVersion": 2,
  "prompt": "画一个任意三角形 ABC，构造三条边的中垂线及外心 O，再画出外接圆。允许拖动三个顶点，标出 OA、OB、OC 的长度。初始坐标由 Agent 选择，三角形不退化。",
  "locale": "zh-CN",
  "outputDir": "output/geometry-benchmark",
  "plan": {
    "program": [
      {
        "id": "A",
        "op": "native",
        "mode": "algebra",
        "source": "A=(0,0)"
      },
      {
        "id": "B",
        "op": "native",
        "mode": "algebra",
        "source": "B=(6,0)"
      },
      {
        "id": "C",
        "op": "native",
        "mode": "algebra",
        "source": "C=(2,4)"
      },
      {
        "id": "triangle",
        "op": "native",
        "mode": "algebra",
        "source": "triangle=Polygon(A,B,C)",
        "outputs": [
          "triangle",
          "a",
          "b",
          "c"
        ]
      },
      {
        "id": "p",
        "op": "native",
        "mode": "algebra",
        "source": "p=PerpendicularBisector(A,B)"
      },
      {
        "id": "q",
        "op": "native",
        "mode": "algebra",
        "source": "q=PerpendicularBisector(B,C)"
      },
      {
        "id": "r",
        "op": "native",
        "mode": "algebra",
        "source": "r=PerpendicularBisector(C,A)"
      },
      {
        "id": "O",
        "op": "native",
        "mode": "algebra",
        "source": "O=Intersect(p,q)"
      },
      {
        "id": "circle",
        "op": "native",
        "mode": "algebra",
        "source": "circle=Circle(O,A)"
      },
      {
        "id": "dA",
        "op": "native",
        "mode": "algebra",
        "source": "dA=Distance(O,A)"
      },
      {
        "id": "dB",
        "op": "native",
        "mode": "algebra",
        "source": "dB=Distance(O,B)"
      },
      {
        "id": "dC",
        "op": "native",
        "mode": "algebra",
        "source": "dC=Distance(O,C)"
      },
      {
        "id": "message",
        "op": "native",
        "mode": "algebra",
        "source": "message=\"OA=\"+dA+\"  OB=\"+dB+\"  OC=\"+dC"
      },
      {
        "id": "NotePos",
        "op": "native",
        "mode": "algebra",
        "source": "NotePos=(0,7)"
      },
      {
        "id": "note",
        "op": "native",
        "mode": "algebra",
        "source": "note=Text(message,NotePos)"
      }
    ],
