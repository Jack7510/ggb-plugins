      {
        "id": "E",
        "op": "freePoint",
        "x": 4,
        "y": 4
      },
      {
        "id": "F",
        "op": "freePoint",
        "x": -1,
        "y": 5
      },
      {
        "id": "baseDE",
        "op": "command",
        "name": "Line",
        "args": [
          {
            "ref": "D"
          },
          {
            "ref": "E"
          }
        ]
      },
      {
        "id": "p",
        "op": "command",
        "name": "Line",
        "args": [
          {
            "ref": "F"
          },
          {
            "ref": "baseDE"
          }
        ]
      },
      {
        "id": "q",
        "op": "command",
