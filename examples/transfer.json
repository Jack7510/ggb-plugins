          {
            "ref": "baseDE"
          }
        ]
      },
      {
        "id": "H",
        "op": "command",
        "name": "Intersect",
        "args": [
          {
            "ref": "q"
          },
          {
            "ref": "baseDE"
          }
        ]
      },
      {
        "id": "FH",
        "op": "command",
        "name": "Segment",
        "args": [
          {
            "ref": "F"
          },
          {
            "ref": "H"
          }
        ]
      },
      {
        "id": "k",
        "op": "command",
        "name": "Circle",
        "args": [
          {
            "ref": "F"
          },
          1.23456789
        ]
      }
