{
  "protocolVersion": 2,
  "prompt": "画一个圆及其内接正多边形，用整数滑块控制边数 n，范围为 3 到 12。显示边数、边长和周长，改变 n 后图形自动更新。初始圆心 O=(0,0)，半径3，n=3。",
  "locale": "zh-CN",
  "outputDir": "output/geometry-benchmark",
  "plan": {
    "program": [
      {
        "id": "O",
        "op": "native",
        "mode": "algebra",
        "source": "O=(0,0)"
      },
      {
        "id": "R",
        "op": "native",
        "mode": "algebra",
        "source": "R=(3,0)"
      },
      {
        "id": "circle",
        "op": "native",
        "mode": "algebra",
        "source": "circle=Circle(O,R)"
      },
      {
        "id": "n",
        "op": "native",
        "mode": "algebra",
        "source": "n=Slider(3,12,1,1,160,false,true,false,false)"
      },
      {
        "id": "turn",
        "op": "native",
        "mode": "algebra",
        "source": "turn=2pi/n"
      },
      {
        "id": "S",
        "op": "native",
        "mode": "algebra",
        "source": "S=Rotate(R,turn,O)"
      },
      {
        "id": "shape",
        "op": "native",
        "mode": "algebra",
        "source": "shape=Polygon(R,S,n)",
        "outputs": [
          "shape",
          "A",
          "f",
          "g",
          "h"
        ]
      },
      {
        "id": "vertices",
        "op": "native",
        "mode": "algebra",
        "source": "vertices=Sequence(Vertex(shape,j),j,1,n)"
      },
      {
        "id": "side",
        "op": "native",
        "mode": "algebra",
        "source": "side=Distance(R,S)"
      },
      {
        "id": "perimeter",
        "op": "native",
        "mode": "algebra",
        "source": "perimeter=Perimeter(shape)"
      },
      {
        "id": "message",
        "op": "native",
        "mode": "algebra",
        "source": "message=\"边数=\"+n+\"  边长=\"+side+\"  周长=\"+perimeter"
      },
      {
        "id": "NotePos",
        "op": "native",
        "mode": "algebra",
        "source": "NotePos=(-4,5)"
      },
      {
        "id": "note",
        "op": "native",
        "mode": "algebra",
        "source": "note=Text(message,NotePos)"
      }
